<Project Sdk="Microsoft.NET.Sdk">

  <!-- 先生PC(Windows 10 の 1903 以降・Windows 11)の中継アプリ。
       Bluetooth LE の「待ち受け役」(GATT サーバー)になり、児童の Chromebook(Web Bluetooth)から届いたバイトを、
       同じパソコンの Node サーバー(server/relay)へ運ぶだけ。組み立て・教室のデータは、すべて Node 側。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TeacherRelay</AssemblyName>
    <RootNamespace>TeacherRelay</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
