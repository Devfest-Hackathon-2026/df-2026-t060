# Cloud Run の GPU で動かす Ollama(Gemma)のコンテナ。モデルをイメージの中に入れておく(起動のたびにダウンロードしないため)。
#
# ビルド(モデルを取りこむので、ネットワークがある Cloud Build で。イメージは約 9GB):
#   gcloud builds submit --config deploy/cloudrun/cloudbuild-ollama.yaml --substitutions _IMAGE=REGION-docker.pkg.dev/PROJECT/kyozai/ollama:latest,_MODEL=gemma4:12b deploy/cloudrun
#
# ★モデルの入れ方は2通り。先生PCで使っている gemma4:12b が、
#   (A) Ollama の公開ライブラリにある名前なら → このファイルのまま(ollama pull)
#   (B) 自分で GGUF を取りこんだものなら(ollama show で parent_model が .gguf のファイルになっている)→ 下の (B) を使う
ARG MODEL=gemma4:12b
FROM ollama/ollama:latest

ENV OLLAMA_HOST=0.0.0.0:11434 \
    OLLAMA_MODELS=/models \
    OLLAMA_KEEP_ALIVE=-1 \
    OLLAMA_NUM_PARALLEL=1 \
    OLLAMA_MAX_LOADED_MODELS=1

# (A) 公開ライブラリから取りこむ
ARG MODEL
RUN ollama serve & \
    for i in $(seq 1 30); do ollama list >/dev/null 2>&1 && break; sleep 1; done; \
    ollama pull "$MODEL" && pkill ollama; sleep 2

# (B) 自分の GGUF を取りこむ場合は、上の (A) の RUN を消して、次の2行にする(deploy/cloudrun/ に gemma.gguf と Modelfile を置く。Modelfile.example を見る)
#   COPY gemma.gguf Modelfile /build/
#   RUN ollama serve & for i in $(seq 1 30); do ollama list >/dev/null 2>&1 && break; sleep 1; done; cd /build && ollama create "$MODEL" -f Modelfile && pkill ollama; sleep 2

EXPOSE 11434
ENTRYPOINT ["/bin/ollama"]
CMD ["serve"]
