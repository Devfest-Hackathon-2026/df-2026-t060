rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Google でログインしている人か(先生になれるのは、Google ログインの人だけ。児童は匿名ログイン)。
    // 匿名ログインに Google をひもづけた(linkWithPopup)アカウントも、identities に google.com が入るので先生になれる
    // (前に匿名で作ったクラスを、同じ uid のまま引き継げる)。
    function isGoogle() {
      return request.auth != null
        && 'google.com' in request.auth.token.firebase.identities;
    }

    // classes/{code}: クラス。作った先生(Google ログインの uid)だけが管理できる
    match /classes/{code} {
      function isTeacher() {
        return isGoogle()
          && get(/databases/$(database)/documents/classes/$(code)).data.teacherUid == request.auth.uid;
      }

      // クラスコードを知っていれば読める。クラスの一覧は、先生が「自分のクラス」だけ取れる(別のブラウザでも、自分のクラスを見つけられる)
      allow get: if request.auth != null;
      allow list: if isGoogle() && resource.data.teacherUid == request.auth.uid;
      // grade(学年)は 5〜9(小5〜中3。対象は小学校高学年から中学生)。前に作ったクラスには無いので、なくてもよい
      allow create: if isGoogle()
        && request.resource.data.keys().hasOnly(['name', 'teacherUid', 'createdAt', 'grade'])
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.createdAt == request.time
        && (!('grade' in request.resource.data)
          || (request.resource.data.grade is int
            && request.resource.data.grade >= 5
            && request.resource.data.grade <= 9));
      allow update, delete: if false;

      // 教材：先生だけが配信・削除。クラスコードを知っている児童は読める
      match /materials/{id} {
        allow read: if request.auth != null;
        allow write: if isTeacher();
      }

      // 質問：児童は「送る」だけ。読む・状態を変える(関係の強さをつける など)のは先生だけ
      //   uid           送った児童(匿名ログイン)。先生がその児童だけに返事をするのに使う。自分の uid しか入れられない
      //   aiTried       先にAIに聞いたが、わからなかった
      //   materialTitle どの教材を見ていて出た質問か
      //   original      端末のAIが「それ」「これ」を具体化する前の、児童のもとの言い方
      match /questions/{id} {
        allow read, update, delete: if isTeacher();
        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/classes/$(code))
          && request.resource.data.keys().hasOnly(['seat', 'text', 'status', 'createdAt', 'uid', 'aiTried', 'materialTitle', 'original', 'inquiryContext'])
          && request.resource.data.seat is int
          && request.resource.data.seat >= 1 && request.resource.data.seat <= 60
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 200
          && request.resource.data.status == 'new'
          && request.resource.data.createdAt == request.time
          && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid)
          && (!('aiTried' in request.resource.data) || request.resource.data.aiTried is bool)
          && (!('materialTitle' in request.resource.data)
            || (request.resource.data.materialTitle is string && request.resource.data.materialTitle.size() <= 60))
          && (!('inquiryContext' in request.resource.data)
            || (request.resource.data.inquiryContext is string && request.resource.data.inquiryContext.size() <= 40000))
          && (!('original' in request.resource.data)
            || (request.resource.data.original is string && request.resource.data.original.size() <= 200));
      }

      // 先生から1人の児童への返事:書けるのは先生だけ。読めるのは、宛先の児童と先生だけ
      match /replies/{id} {
        allow create, update, delete: if isTeacher();
        allow read: if request.auth != null
          && (resource.data.uid == request.auth.uid || isTeacher());
      }
    }
  }
}
